SECRET_KEY=add-a-strong-random-django-secret-key
HUGGINGFACE_API_KEY=add-your-huggingface-api-key
OLLAMA_SERVER=http://host.docker.internal:11434

# Non-empty key: show only OpenAI LLMs and embedding models.
# Missing/empty key: use Ollama mode and local model defaults.
# Create a key at https://platform.openai.com/api-keys (API billing required).
# OpenAI requests send prompts, context, chat history, and embedding inputs to OpenAI.
# Keep this key backend-only; never put it in .env_frontend or commit it.
OPENAI_API_KEY=

POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres