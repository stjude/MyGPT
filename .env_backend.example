SECRET_KEY=add-a-strong-random-django-secret-key
HUGGINGFACE_API_KEY=add-your-huggingface-api-key
OLLAMA_SERVER=http://host.docker.internal:11434

# Generation provider: ollama (default), openai, or vllm.
# Keep credentials in this backend-only file, never VITE_* or browser settings.
LLM_PROVIDER=ollama
# For an OpenAI-compatible server, include its API prefix (usually /v1).
LLM_BASE_URL=http://host.docker.internal:8001/v1
LLM_API_KEY=
LLM_MAX_OUTPUT_TOKENS=2048
LLM_TIMEOUT_SECONDS=120
LLM_TOKEN_PARAMETER=max_tokens
LLM_SEND_SAMPLING=true
LLM_EXTRA_BODY={}

POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
