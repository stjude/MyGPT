SECRET_KEY=add-a-strong-random-django-secret-key
HUGGINGFACE_API_KEY=add-your-huggingface-api-key
OLLAMA_SERVER=http://host.docker.internal:11434

# Required for the default gpt-6-luna LLM or OpenAI embedding models.
# Optional if you select only local Ollama LLMs and embeddings.
# Create a key at https://platform.openai.com/api-keys (API billing required).
# OpenAI requests send prompts, context, chat history, and embedding inputs to OpenAI.
# Keep this key backend-only; never put it in .env_frontend or commit it.
OPENAI_API_KEY=
# Optional: PEM CA certificate from your IT team for an HTTPS-inspecting proxy.
# Use a path INSIDE the backend container; mount the file read-only.
# Adds trust for OpenAI LLMs and embeddings without disabling TLS verification.
# OPENAI_CA_BUNDLE=/etc/mygpt-certs/organization-ca.pem

POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres